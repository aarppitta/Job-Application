# Copy this file to ".env" (same folder) and change the values.

# PostgreSQL connection (database name: germany_jobs)
DATABASE_URL=postgresql+psycopg://localhost:5432/germany_jobs

# Any long random text. Create one with:  python3 -c "import secrets; print(secrets.token_urlsafe(40))"
SECRET_KEY=change-me-in-the-env-file-to-a-long-random-text

# Job roles to search for, comma-separated (empty = Arpita's roles). The Settings page can change them later.
JOB_KEYWORDS=

# Optional: Anthropic API key. Enables company/interview research (web search), mock-interview grading and
# Claude cover letters. Leave empty: everything else works without it.
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# The only login (created automatically when the backend starts). Change the password!
MASTER_USERNAME=arpita
MASTER_PASSWORD=JobHunt@2026
