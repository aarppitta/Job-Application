# Settings for Germany Job Automation. Locally: copy to ".env". On Vercel: Project → Settings → Environment Variables.
# Only DATABASE_URL, SECRET_KEY and MASTER_PASSWORD are required on Vercel; everything else has a sensible default.

# ---------------------------------------------------------------- database
# Local:  postgresql+psycopg://localhost:5432/germany_jobs
# Neon:   paste the POOLED connection string (host contains "-pooler"), e.g.
#         postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#         ("postgresql://" is converted automatically; the Neon integration's POSTGRES_URL also works)
DATABASE_URL=postgresql+psycopg://localhost:5432/germany_jobs
# DB_POOL_SIZE=5          # connections per server process (serverless always uses 1)
# AUTO_MIGRATE=true       # create tables / safe column changes on start-up

# ---------------------------------------------------------------- login (single user, no registration)
# Long random text that signs login tokens (required on Vercel, ≥ 32 characters):
#   python3 -c "import secrets; print(secrets.token_urlsafe(40))"
SECRET_KEY=change-me-in-the-env-file-to-a-long-random-text
MASTER_USERNAME=arpita
MASTER_PASSWORD=JobHunt@2026        # required to change on Vercel (≥ 10 characters, not this default)
# TOKEN_DAYS=7

# ---------------------------------------------------------------- how it runs
# RUN_MODE=auto           # auto = serverless on Vercel, server elsewhere | server | serverless
# STEP_SECONDS=240        # max length of one serverless search step (Vercel Hobby limit: 300 s)
# CRON_SECRET=            # Vercel only: long random text; Vercel Cron sends it so nobody else can trigger runs
# DAILY_SCHEDULER=true    # server mode: start the automation daily at the time set in Settings
# CORS_ORIGINS=["http://localhost:5001"]   # only if the frontend is on ANOTHER domain than the API

# ---------------------------------------------------------------- your search and your CV
# Job roles to search for, comma-separated (empty = Arpita's roles). The Settings page can change them later.
JOB_KEYWORDS=
# Use someone else's CV: JSON with the same keys as DEFAULT_PROFILE in backend/app/defaults.py
# (name, headline, location, summary, education, experience, projects, skills, target_roles, …). Used when the profile is created.
# PROFILE_JSON={"name": "Jane Doe", "skills": ["Python", "SQL"], "target_roles": ["Data Engineer"]}
# PROFILE_FILE=/path/to/my_cv.json

# ---------------------------------------------------------------- optional: AI
# Enables company/interview research (web search), mock-interview grading, AI answer drafts and AI cover letters.
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- frontend (build time, only if the API is on another domain)
# VITE_API_URL=https://my-api.example.com
