{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": [
    "fra1"
  ],
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "backend/app/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily?slot=1",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily?slot=2",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/daily?slot=3",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily?slot=4",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/daily?slot=5",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/daily?slot=6",
      "schedule": "0 8 * * *"
    }
  ]
}
